      "seconds": 1.5717
    },
    {
      "id": "v09",
      "scene": "product",
      "text": "We map how AI work actually runs.",
      "file": "audio/vo/v09.wav",
      "seconds": 2.2208
    },
    {
      "id": "v10",
      "scene": "product",
      "text": "We identify expensive paths, test alternatives, and measure what changes.",
      "file": "audio/vo/v10.wav",
      "seconds": 4.8306
    },
    {
      "id": "v11",
      "scene": "product",
      "text": "We replay representative workloads against defined requirements.",
      "file": "audio/vo/v11.wav",
      "seconds": 4.1391
    },
    {
      "id": "v12",
      "scene": "verification",
      "text": "If the evidence passes, the change can be reviewed.",
      "file": "audio/vo/v12.wav",
      "seconds": 2.9054
    },
    {
      "id": "v13",
      "scene": "verification",
      "text": "If quality drops, it's rejected.",
      "file": "audio/vo/v13.wav",
      "seconds": 2.0062
    },
    {
      "id": "v14",
      "scene": "verification",
      "text": "If the proof isn't there, we say: incomplete.",
      "file": "audio/vo/v14.wav",
      "seconds": 2.5941
    },
    {
      "id": "v15",
      "scene": "verification",
      "text": "No blind switches.",
      "file": "audio/vo/v15.wav",
      "seconds": 1.4109
    },
    {
      "id": "v16",
      "scene": "verification",
      "text": "No manufactured savings.",
      "file": "audio/vo/v16.wav",
      "seconds": 1.7099
    },
    {
