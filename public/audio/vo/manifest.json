    },
    {
      "id": "v03",
      "scene": "cost",
      "text": "So do the tokens, the models, the retries, and the costs.",
      "file": "audio/vo/v03.wav",
      "seconds": 3.3966
    },
    {
      "id": "v04",
      "scene": "risk",
      "text": "The obvious fix?",
