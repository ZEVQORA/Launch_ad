      "seconds": 1.5147
    },
    {
      "id": "v06",
      "scene": "risk",
      "text": "But cheaper can fail quietly.",
      "file": "audio/vo/v06.wav",
      "seconds": 1.7438
    },
    {
      "id": "v07",
      "scene": "risk",
      "text": "A lower bill means nothing if the result breaks.",
